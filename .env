HTTP_PORT=8080
VERSION=1.0.0
SERVICE_NAME=Student Management System
JWT_SECRET_KEY=very_strong_secret_key123


## Database configuration

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_NAME=student_management_db
DB_SSL_MODE=false


## Goosee configuration
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=host=localhost user=postgres password=postgres-password dbname=student_management_db sslmode=disable
GOOSE_MIGRATION_DIR=./sql/migrations       