HTTP_PORT=8080
VERSION=1.0.0
SERVICE_NAME=Student Management System
JWT_SECRET_KEY=your_strong_secret_key_here


## Database configuration

DB_HOST=localhost
DB_PORT=your_db_port
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=student_management_db
DB_SSL_MODE=false


## Goosee configuration
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=host=localhost user=your_db_user password=your_db_password dbname=student_management_db sslmode=disable
GOOSE_MIGRATION_DIR=./sql/migrations       